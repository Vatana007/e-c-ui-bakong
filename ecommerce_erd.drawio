        <!-- 3. Categories -> Products (Horizontal straight line, 1:N) -->
        <mxCell id="edge_cat_products" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERmandOne;endArrow=ERmany;strokeColor=#FFFFFF;strokeWidth=1;fontColor=#FFFFFF;labelBackgroundColor=#121212;labelBorderColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="tbl_categories" target="tbl_products">
          <mxGeometry relative="1" as="geometry" />
