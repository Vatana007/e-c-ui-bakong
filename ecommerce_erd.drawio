        <!-- 4. Products -> Order_Items (Vertical straight line, 1:N) -->
        <mxCell id="edge_prod_items" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERmandOne;endArrow=ERmany;strokeColor=#FFFFFF;strokeWidth=1;fontColor=#FFFFFF;labelBackgroundColor=#121212;labelBorderColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="tbl_products" target="tbl_order_items">
          <mxGeometry relative="1" as="geometry" />
